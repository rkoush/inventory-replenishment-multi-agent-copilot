# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: cheaper/faster model just for the supervisor's routing step
GROQ_ROUTER_MODEL=
GROQ_MAX_TOKENS=768
MCP_SERVER_URL=http://localhost:8000/mcp
# Optional: if set, the MCP server requires "Authorization: Bearer <token>" and the agents send it
MCP_AUTH_TOKEN=
