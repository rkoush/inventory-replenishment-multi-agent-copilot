# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Cheaper/faster model for the supervisor's routing step
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# Output cap; for reasoning models this includes reasoning tokens
GROQ_MAX_TOKENS=1024
# gpt-oss / qwen3 only: low | medium | high
GROQ_REASONING_EFFORT=low
MCP_SERVER_URL=http://localhost:8000/mcp
# Optional: if set, the MCP server requires "Authorization: Bearer <token>" and the agents send it
MCP_AUTH_TOKEN=
